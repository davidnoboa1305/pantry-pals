# rename this file to ".env.local" and replace the values with your Supabase project credentials
# Project settings -> API KEYS -> publishable key (anon) and secret key (service_role)
# Project settings -> DATA API: URL (for NEXT_PUBLIC_SUPABASE_URL) 
NEXT_PUBLIC_SUPABASE_URL=your-project-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-secret-service-role-key